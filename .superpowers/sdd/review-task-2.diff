+      taskId: 'tw-100',
+      sessionId: 'session-1',
+      sourceSlug: 'teambition',
+      state: 'claimed',
+      claimedAt: '2026-07-12T10:00:00.000Z',
+    })
+    const second = await claimBinding(root, {
